# Server
NODE_ENV=development
PORT=3001

# LLM Provider — pilih salah satu: claude | gemini
LLM_PROVIDER=gemini

# required: override model default per provider
LLM_MODEL=gemini-2.5-flash

# API Keys — isi sesuai provider yang dipakai
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Tools
TAVILY_API_KEY=

# PostgreSQL
POSTGRES_USER=bizresearch
POSTGRES_PASSWORD=bizresearch_dev
POSTGRES_DB=bizresearch
DATABASE_URL=postgresql://bizresearch:bizresearch_dev@localhost:5432/bizresearch

# Redis
REDIS_URL=redis://localhost:6379

# Auth — gunakan random string minimal 32 karakter
JWT_SECRET=

# CORS
FRONTEND_URL=http://localhost:5173