# ============================================================
# BizResearch Agent — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# ─── Server ───────────────────────────────────────────────────────────────────

# Application environment. Use 'development' locally, 'production' on server.
NODE_ENV=development

# Port the Express server listens on.
PORT=3001

# ─── LLM Provider ─────────────────────────────────────────────────────────────

# Active LLM provider. Accepted values: claude | gemini
# Swap this value and restart the server to switch providers instantly.
LLM_PROVIDER=gemini

# Model override. If omitted, each adapter falls back to its default model.
# Examples:
#   gemini  → gemini-2.5-flash
#   claude  → claude-sonnet-4-5
LLM_MODEL=gemini-2.5-flash

# ─── API Keys ─────────────────────────────────────────────────────────────────

# Required only when LLM_PROVIDER=claude
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required only when LLM_PROVIDER=gemini
# Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# ─── Tools ────────────────────────────────────────────────────────────────────

# Required. Used by the web search tool.
# Free tier: 1,000 requests/month — https://tavily.com/
TAVILY_API_KEY=

# ─── PostgreSQL ───────────────────────────────────────────────────────────────

# These values must match what is set in docker-compose.yml
POSTGRES_USER=bizresearch
POSTGRES_PASSWORD=bizresearch_dev
POSTGRES_DB=bizresearch

# Full connection string — constructed from the values above.
# In Docker Compose, hostname is the service name (e.g., 'postgres').
# Locally, use 'localhost'.
DATABASE_URL=postgresql://bizresearch:bizresearch_dev@localhost:5432/bizresearch

# ─── Redis ────────────────────────────────────────────────────────────────────

# Redis connection string.
# In Docker Compose, hostname is the service name (e.g., 'redis').
# Locally, use 'localhost'.
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────

# Secret used to sign JWT tokens. Must be at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ─── CORS ─────────────────────────────────────────────────────────────────────

# URL of the frontend app. Requests from other origins will be rejected.
# In production, set this to your actual frontend domain.
FRONTEND_URL=http://localhost:5173