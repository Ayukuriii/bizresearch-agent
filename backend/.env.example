# Server
NODE_ENV=development
PORT=3001

# LLM Provider — pilih salah satu: claude | gemini | groq
LLM_PROVIDER=gemini

# Optional: override model default per provider
# LLM_MODEL=gemini-1.5-flash

# API Keys — isi sesuai provider yang dipakai
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
GROQ_API_KEY=

# Tools
TAVILY_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/bizresearch

# Redis
REDIS_URL=redis://localhost:6379

# Auth — gunakan random string minimal 32 karakter
JWT_SECRET=

# CORS
FRONTEND_URL=http://localhost:5173